{
  "name": "dog-walker-game",
  "version": "0.0.1",
  "description": "A cozy pixel-art lane runner about walking dogs.",
  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "prebuild": "npm run export:data",
    "build": "vite build",
    "build:deploy": "npm run build",
    "preview": "npm run build && wrangler dev",
    "check": "tsc",
    "lint": "prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "check:art": "vitest run src/assets/ src/scenes/artCoverage.test.ts src/tools/artManifest.test.ts",
    "art:unused": "tsx src/assets/unusedArtCli.ts",
    "simulate": "tsx src/sim/cli.ts",
    "export:data": "tsx src/tools/dataExportCli.ts",
    "art:manifest": "tsx src/tools/artManifestCli.ts",
    "art:depth-preview": "tsx src/tools/depthPreviewCli.ts",
    "deploy": "npm run build && wrangler deploy",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "markdown-it": "15.0.3"
  }
}
